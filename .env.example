# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). A chave publishable pode ficar no navegador: quem protege
# os dados é a RLS. Nunca coloque aqui a secret/service_role key.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
